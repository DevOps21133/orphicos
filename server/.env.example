# OrphicOS server (brain) environment — SERVER-ONLY.
# Copy to server/.env (gitignored) and fill in. The real .env is NEVER committed
# and NEVER shipped to a user. The LLM API key lives ONLY here (Rules 1 & 6);
# it must never appear anywhere under client/.
#
# The provider behind these credentials is an internal detail (Rule 2) — it is
# named only in server/brain.py and THIRD-PARTY-NOTICES.txt.

LLM_API_KEY=
LLM_MODEL=
