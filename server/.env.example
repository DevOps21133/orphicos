# Server-only secrets. Copy to server/.env (gitignored).
# This file never ships to users and its values never appear client-side.

# Reasoning-provider API key (used only by server/provider.py)
BRAIN_PROVIDER_KEY=

# Comma-separated client tokens accepted by the brain service.
# Empty = auth disabled (local dev only). Set before exposing beyond localhost.
BRAIN_CLIENT_TOKENS=
