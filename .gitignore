# Secrets — never commit any real .env
# (the LLM_API_KEY lives ONLY in server/.env, server-side — Rules 1 & 6).
# .env.example files are intentionally tracked and are NOT matched by this rule.
**/.env

# Per-user auth tokens + accounts + skill entitlements (issued at runtime; not for git)
server/tokens.json
server/users.json
server/entitlements.json

# Per-machine client config (SERVER_BASE etc.); config.example.toml is tracked instead
client/config.toml

# Python
__pycache__/
*.py[cod]

# Virtual environments (Phase 2 creates ./.venv on the client)
.venv/
venv/

# Logs
*.log

# Model weights / caches / engine logs
/models
engine/*/logs

# PyInstaller output
/build/
/dist/
*.manifest
